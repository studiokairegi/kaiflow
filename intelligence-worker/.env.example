# KairFlow Intelligence worker configuration template.
# Copy to a private worker.env file; never commit real credentials.

KAIRFLOW_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
KAIRFLOW_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
KAIRFLOW_AGENT_EMAIL=worker@example.com
# Leave blank when the password is stored in Windows Credential Manager (keyring).
KAIRFLOW_AGENT_PASSWORD=

# Ollama must remain on this computer; the controller rejects remote hosts.
KAIRFLOW_OLLAMA_URL=http://127.0.0.1:11434
KAIRFLOW_OLLAMA_MODEL=qwen2.5:3b-instruct
KAIRFLOW_OLLAMA_FAST_MODEL=qwen2.5:1.5b-instruct

# Optional operational identity and contact details.
KAIRFLOW_WORKER_ID=
KAIRFLOW_CONTACT_URL=
KAIRFLOW_POLL_SECONDS=15

# Dynamic provider accounts are assigned by the server-side account registry.
# Keep the legacy adapter selector disabled unless an explicitly approved rollout requires it.
KAIRFLOW_MAIL_PROVIDER=none
KAIRFLOW_MAIL_ACCOUNT_ID=

# --- Gemini-first AI routing (Phase 2). Everything below is optional; with none of it set, every call site uses local Ollama as before. ---
# Gemini key is read from KAIRFLOW_GEMINI_API_KEY or Windows Credential Manager. Free tier only: never enable billing on the Google project.
# Phase 6: ONE pinned model for everything. Both settings default to gemini-3.8-flash; each must be an exact ID (a "latest" alias is rejected at startup).
# KAIRFLOW_GEMINI_MODEL is Agent Chat planning; KAIRFLOW_GEMINI_JSON_MODEL is the structured-extraction path. Leave both unset unless you must pin another exact ID.
# KAIRFLOW_GEMINI_MODEL=gemini-3.8-flash
# KAIRFLOW_GEMINI_JSON_MODEL=gemini-3.8-flash
# Per-call-site routing: comma-separated group=ollama|gemini_first. Groups: discovery, research, drafting, classification, chat, health.
# A single site can be named as group.name. Built-in default (Phase 4): discovery and research=gemini_first, everything else ollama. Entries here override it.
# With no Gemini key the worker uses Ollama for everything. To put discovery and research back on Ollama: KAIRFLOW_AI_POLICY=discovery=ollama,research=ollama (or KAIRFLOW_AI_FORCE_OLLAMA=1 for everything)
# KAIRFLOW_AI_POLICY=
# Decision D1: A (default) keeps drafting, classification and Agent Chat (CRM contact data + conversation history) on Ollama. C sends them unredacted.
# Phase 5: the drafting sites (drafting.initial, drafting.followup, drafting.reply, drafting.takeover, drafting.takeover_followup,
# drafting.takeover_reply, drafting.takeover_analysis) go through the router and log which provider wrote each draft. With D1=A they never leave Ollama.
# To let them try Gemini first you need BOTH: KAIRFLOW_AI_D1=C and KAIRFLOW_AI_POLICY=drafting=gemini_first. Drafts always stay pending approval.
# Phase 6: inbound classification (site classification.inbound) is private. With D1=A it stays on Ollama whatever the policy says.
# To let it try Gemini first you need BOTH: KAIRFLOW_AI_D1=C and KAIRFLOW_AI_POLICY=classification=gemini_first. The deterministic rules in classify.py
# (bounce, auto-reply, unsubscribe, complaint, contract/meeting words, confidence floor) always run first and decide the same way for either provider.
# Agent Chat (site chat.plan) contains historical messages and may return CRM contact records. D1=A keeps the whole context on Ollama.
# To allow Gemini, explicitly set D1=C and KAIRFLOW_AI_POLICY=chat=gemini_first; the context is sent unredacted.
# KAIRFLOW_AI_D1=A
# Rollback: 1 forces Ollama for everything, including Agent Chat and the health checks (the selftest then reports SKIP, not PASS).
# KAIRFLOW_AI_FORCE_OLLAMA=0
# thinkingLevel for Gemini 3.x: low (default), medium or high. Thinking cannot be disabled; "off" and "minimal" are rejected.
# KAIRFLOW_GEMINI_THINKING=low
# KAIRFLOW_GEMINI_MAX_OUTPUT_FAST=2048
# KAIRFLOW_GEMINI_MAX_OUTPUT=4096
# Local free-tier caps (take the figures from AI Studio's rate-limit view). 0 or unset = no local cap; Google's 429s are still honoured.
# KAIRFLOW_GEMINI_RPM=0
# KAIRFLOW_GEMINI_RPD=0
# KAIRFLOW_GEMINI_DRAFT_RESERVE=0.25
# KAIRFLOW_GEMINI_DAILY_COOLDOWN_SECONDS=10800
