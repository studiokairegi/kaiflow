# Copy to a file OUTSIDE the repository (or set as machine environment variables). Never commit real values.
KAIRFLOW_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
KAIRFLOW_SUPABASE_ANON_KEY=
KAIRFLOW_AGENT_EMAIL=
KAIRFLOW_AGENT_PASSWORD=
KAIRFLOW_OLLAMA_URL=http://127.0.0.1:11434
KAIRFLOW_OLLAMA_MODEL=qwen2.5:3b-instruct
KAIRFLOW_OLLAMA_FAST_MODEL=qwen2.5:1.5b-instruct
KAIRFLOW_WORKER_ID=
KAIRFLOW_POLL_SECONDS=15
KAIRFLOW_CONTACT_URL=
# Safe default is none. Select resend only after deploying the Intelligence Edge Functions and configuring Resend.
# Supported: none, resend, gmail, zoho. The Resend API key is NEVER set on this worker.
KAIRFLOW_MAIL_PROVIDER=none
