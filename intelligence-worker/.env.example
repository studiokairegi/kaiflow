# KairFlow Intelligence worker configuration template.
# Copy to a private worker.env file; never commit real credentials.

KAIRFLOW_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
KAIRFLOW_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
KAIRFLOW_AGENT_EMAIL=worker@example.com
# Leave blank when the password is stored in Windows Credential Manager (keyring).
KAIRFLOW_AGENT_PASSWORD=

# Ollama must remain on this computer; the controller rejects remote hosts.
KAIRFLOW_OLLAMA_URL=http://127.0.0.1:11434
KAIRFLOW_OLLAMA_MODEL=qwen2.5:3b-instruct
KAIRFLOW_OLLAMA_FAST_MODEL=qwen2.5:1.5b-instruct

# ---- Gemini (primary cloud provider; Ollama is always the fallback) ----------------------------------------------------------
# Owner decisions recorded 12 Nov 2026: FREE TIER ONLY (never enable billing), D1=C, conservative local caps.
# Leave the key blank to use Ollama only. The key stays on this machine (server-side); it is never logged or sent anywhere but Google.
KAIRFLOW_GEMINI_API_KEY=
# Exact pinned model IDs only (a "latest" alias is rejected at startup). KAIRFLOW_GEMINI_MODEL is Agent Chat; JSON_MODEL is structured calls.
KAIRFLOW_GEMINI_MODEL=gemini-3.8-flash
KAIRFLOW_GEMINI_JSON_MODEL=gemini-3.8-flash
# Optional exact model ID for fast=True structured calls (for example a Flash-Lite model, once benchmarked). Blank = use JSON_MODEL.
KAIRFLOW_GEMINI_FAST_MODEL=
KAIRFLOW_GEMINI_THINKING=low
KAIRFLOW_GEMINI_MAX_OUTPUT_FAST=2048
KAIRFLOW_GEMINI_MAX_OUTPUT=4096

# Local request caps (0 = no local cap). Conservative free-tier values; lower them if Google's AI Studio shows smaller quotas for your model.
KAIRFLOW_GEMINI_RPM=10
KAIRFLOW_GEMINI_RPD=200
# Share of the daily cap that only drafting may use (applies only while drafting can reach Gemini).
KAIRFLOW_GEMINI_DRAFT_RESERVE=0.25
# Seconds Gemini is skipped after daily-quota exhaustion before it is probed again.
KAIRFLOW_GEMINI_DAILY_COOLDOWN_SECONDS=10800

# ---- Routing ----------------------------------------------------------------------------------------------------------------
# D1 = A: private groups (drafting, classification, chat) stay on Ollama.  D1 = C: they may use Gemini UNREDACTED.
# With the free tier Google may use prompts to improve its products, so C sends private CRM, email and chat text under those terms.
# To roll back, set KAIRFLOW_AI_D1=A (or KAIRFLOW_AI_FORCE_OLLAMA=1) and restart the worker.
KAIRFLOW_AI_D1=C
# Comma-separated group[.site]=ollama|gemini_first entries. Built-in default (when this is empty): discovery and research Gemini-first, the rest Ollama.
# Owner decision 13 Nov 2026: Gemini does everything. `default=gemini_first` sends EVERY group (discovery, research, drafting, classification,
# Agent Chat) to Gemini first, with Ollama as the automatic fallback. It needs KAIRFLOW_AI_D1=C, so private correspondence, CRM contacts and
# chat history go to Google unredacted. (The health.ollama selftest site still checks Ollama on purpose.)
# To keep one group local, add it after the default, for example: default=gemini_first,chat=ollama
# Chat-only Gemini instead: default=ollama,chat=gemini_first
KAIRFLOW_AI_POLICY=default=gemini_first
# 1 = send everything to Ollama (emergency rollback).
KAIRFLOW_AI_FORCE_OLLAMA=0

# ---- Operational identity and mail ------------------------------------------------------------------------------------------
KAIRFLOW_WORKER_ID=
KAIRFLOW_WORKER_LOG_FILE=
KAIRFLOW_CONTACT_URL=
KAIRFLOW_POLL_SECONDS=15
# Dynamic provider accounts are assigned by the server-side account registry. Outbound sending stays disabled.
KAIRFLOW_MAIL_PROVIDER=none
KAIRFLOW_MAIL_ACCOUNT_ID=
