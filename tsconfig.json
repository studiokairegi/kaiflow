{
  // Type-checks the plain-JS app (no migration to .ts). Run via `npm run typecheck`,
  // which compares against typecheck-baseline.json so only NEW type errors fail CI.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.d.ts"],
  "exclude": ["src/**/*.test.mjs", "node_modules", "dist", "supabase", "intelligence-worker", "docs"]
}
