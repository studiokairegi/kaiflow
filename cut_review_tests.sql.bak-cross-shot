-- Second block: replacement release, revisions, withdrawal, isolation.
do $$
declare
  u1 uuid; proj uuid; shot uuid; v1 uuid; v2 uuid; r jsonb; n int; ok boolean; s text; ptoken text; stoken text;
begin
  select user_id, id, share_token into u1, proj, ptoken from projects where name = 'T proj' limit 1;
  select id, share_token into shot, stoken from shots where project_id = proj limit 1;
