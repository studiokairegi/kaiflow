  perform client_request_revisions(ptoken, shot, v2, 'Client Name', 'the transition at 00:12 is too abrupt');
  select workflow_state into s from shots where id = shot;
  if s <> 'released' then raise exception 'T21: revision request must not change internal workflow state, got %', s; end if;
