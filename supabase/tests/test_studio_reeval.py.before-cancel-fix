class Cli(unittest.TestCase):
    def run_cli(self, argv, eligible=278):
        calls, lines = [], []
        def rpc(name, params=None):
            calls.append((name, params))
            return {"eligible": eligible} if params and params.get("p_dry_run") else {"run_id": RUN}
        return research and (studio_reeval.cli(rpc, argv, out=lines.append), calls, lines)

    def test_preview_is_a_dry_run_only(self):
        code, calls, _ = self.run_cli(["preview"])
        self.assertEqual(code, 0); self.assertTrue(all(a["p_dry_run"] for _, a in calls))

    def test_start_refuses_without_a_limit_or_an_explicit_full_population(self):
        for argv in (["start"], ["start", "--limit", "0"], ["start", "--limit", "x"], ["start", "--limit", "5", "--all"], ["start", "--all"], ["start", "--all", "--expect", "10"]):
            code, calls, _ = self.run_cli(argv); self.assertEqual(code, 2, argv); self.assertFalse([1 for _, a in calls if not a["p_dry_run"]], argv)

    def test_pilot_and_full_start(self):
        code, calls, _ = self.run_cli(["start", "--limit", "5"]); self.assertEqual(code, 0)
        self.assertEqual([a["p_limit"] for _, a in calls if not a["p_dry_run"]], [5])
        code, calls, _ = self.run_cli(["start", "--all", "--expect", "278"]); self.assertEqual(code, 0)
        self.assertEqual([a["p_limit"] for _, a in calls if not a["p_dry_run"]], [None])

    def test_cli_only_calls_reeval_functions(self):
        for argv in (["preview"], ["start", "--limit", "3"], ["status"], ["cancel", RUN]):
            _, calls, _ = self.run_cli(argv); self.assertTrue(all(n.startswith("intel_agent_reeval_") for n, _ in calls), argv)


class StaticMigrationGuards(unittest.TestCase):
    """Text checks on the unexecuted migration. They catch accidental edits; they do not prove the SQL runs."""
    SQL = (pathlib.Path(__file__).resolve().parents[2] / "supabase" / "migrations" / "20261117090000_intelligence_studio_reevaluation.sql").read_text()

    def test_every_per_prospect_function_rechecks_scope(self):
        for fn in ("reeval_context", "reeval_add_evidence", "reeval_set_website", "reeval_record_research", "reeval_set_score", "reeval_finish_item"):
            body = self.SQL.split(f"function public.intel_agent_{fn}(", 1)[1].split("end $$;", 1)[0]
            self.assertIn("_intel_reeval_check(", body, fn)
        chk = self.SQL.split("function public._intel_reeval_check", 1)[1].split("end $$;", 1)[0]
        self.assertIn("'animation_studio_support'", chk); self.assertIn("'discovered'", chk)

    def test_migration_never_writes_settings_leads_messages_or_sends(self):
        sql = re.sub(r"--[^\n]*", "", self.SQL)
        for pat in (r"update\s+public\.intel_settings", r"insert\s+into\s+public\.leads", r"update\s+public\.leads", r"insert\s+into\s+public\.intel_messages", r"update\s+public\.intel_messages", r"intel_agent_reserve_send", r"kill_switch\s*="):
            self.assertIsNone(re.search(pat, sql, re.I), pat)
        self.assertIn("else 'needs_review'", sql); self.assertIn("'reeval_studio'", sql); self.assertIn("p_dry_run boolean default true", sql)

    def test_job_kind_list_keeps_every_earlier_kind(self):
        for k in ("discover", "research", "qualify", "resolve", "draft", "send", "sync_mail", "classify", "reconcile", "followup_scan", "retention", "chat", "seed_sources", "analyze_site",
                  "news_scan", "feed_poll", "crawl_index", "manual_post", "profile_terms", "takeover"):
            self.assertIn(f"'{k}'", self.SQL.split("intel_jobs_kind_check check", 1)[1].split(";", 1)[0], k)


