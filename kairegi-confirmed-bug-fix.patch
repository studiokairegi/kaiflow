@@ -0,0 +1,98 @@
+-- Keep queued send work queued while the studio kill switch is enabled.
+-- A kill-switch stop is an operator pause, not a successful job completion.
+
+create or replace function public.intel_agent_defer_job(
+  p_job_id uuid,
+  p_worker_id text,
+  p_reason text default 'deferred',
+  p_retry_seconds int default 300
+) returns boolean
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+declare
+  v_org uuid := public.intel_agent_org();
+begin
+  update public.intel_jobs
+     set state = 'queued',
+         run_after = now() + make_interval(secs => greatest(1, least(p_retry_seconds, 86400))),
+         locked_by = null,
+         lease_until = null,
+         last_error = null,
+         finished_at = null,
+         updated_at = now()
+   where id = p_job_id
+     and organization_id = v_org
+     and state = 'running'
+     and locked_by = p_worker_id;
+
+  return found;
+end
+$$;
+
+-- Do not claim send jobs while the emergency stop is active. This prevents
+-- needless claim/defer churn; h_send + intel_agent_defer_job still cover the
+-- race where the switch changes after a job is claimed.
+create or replace function public.intel_agent_claim_job(
+  p_worker_id text,
+  p_kinds text[] default null,
+  p_lease_seconds int default 300
+) returns jsonb
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+declare
+  v_org uuid := public.intel_agent_org();
+  v_job public.intel_jobs;
+begin
+  update public.intel_jobs
+     set state = case when attempts >= max_attempts then 'dead' else 'queued' end,
+         locked_by = null,
+         lease_until = null,
+         last_error = left(concat_ws(' | ', nullif(last_error, ''),
+           'lease expired at ' || now()::text || ' (previous owner ' || coalesce(locked_by, 'unknown') || ')'), 1000),
+         updated_at = now(),
+         finished_at = case when attempts >= max_attempts then now() else null end
+   where organization_id = v_org
+     and state = 'running'
+     and lease_until is not null
+     and lease_until <= now();
+
+  select * into v_job
+    from public.intel_jobs
+   where organization_id = v_org
+     and state = 'queued'
+     and run_after <= now()
+     and (p_kinds is null or kind = any (p_kinds))
+     and not (
+       kind = 'send'
+       and coalesce((
+         select s.kill_switch
+           from public.intel_settings s
+          where s.organization_id = v_org
+          limit 1
+       ), true)
+     )
+   order by priority desc, run_after, created_at
+   limit 1
+   for update skip locked;
+
+  if not found then
+    return null;
+  end if;
+
+  update public.intel_jobs
+     set state = 'running',
+         attempts = attempts + 1,
+         locked_by = left(p_worker_id, 80),
+         lease_until = now() + make_interval(secs => greatest(30, least(p_lease_seconds, 3600))),
+         updated_at = now(),
+         finished_at = null
+   where id = v_job.id
+   returning * into v_job;
+
+  return to_jsonb(v_job);
+end
+$$;
