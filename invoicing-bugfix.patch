diff -ruN a/src/invoiceNumbering.js b/src/invoiceNumbering.js
--- a/src/invoiceNumbering.js	1970-01-01 00:00:00.000000000 +0000
+++ b/src/invoiceNumbering.js	2026-11-15 03:12:21.102120296 +0000
@@ -0,0 +1,44 @@
+// Invoice reference numbering.
+//
+// The database enforces ONE reference per user across ALL of that user's projects
+// (unique index invoices_user_number_uniq on invoices(user_id, invoice_number), migration_settings_v2.sql).
+// Numbers must therefore be chosen from every invoice the user owns, never from a single project's invoices:
+// a per-project list suggests INV-0001 again for the second project and the save fails with 23505.
+
+const norm = (n) => String(n ?? "").trim().toLowerCase();
+
+// Rows that belong to this user (the unique index is per user_id). Rows shared in from another studio owner
+// have a different user_id and cannot collide with a number this user creates.
+export function ownedInvoices(invoices, userId) {
+  return (Array.isArray(invoices) ? invoices : []).filter((i) => !i?.ownerUserId || !userId || i.ownerUserId === userId);
+}
+
+export function isInvoiceNumberTaken(invoices, number) {
+  const n = norm(number);
+  if (!n) return false;
+  return (Array.isArray(invoices) ? invoices : []).some((i) => norm(i?.invoiceNumber) === n);
+}
+
+const trailingNumber = (ref) => {
+  const m = String(ref || "").match(/(\d+)$/);
+  return m ? parseInt(m[1], 10) : 0;
+};
+
+// `count` consecutive free references with the given prefix, e.g. ["INV-0004", "INV-0005"].
+// Starts after the highest trailing number in use and also skips any reference that is already taken.
+export function nextInvoiceNumbers(invoices, count, prefix = "INV") {
+  const list = Array.isArray(invoices) ? invoices : [];
+  const taken = new Set(list.map((i) => norm(i?.invoiceNumber)));
+  let n = list.reduce((m, i) => Math.max(m, trailingNumber(i?.invoiceNumber)), 0);
+  const out = [];
+  while (out.length < count) {
+    n += 1;
+    const candidate = `${prefix}-${String(n).padStart(4, "0")}`;
+    if (taken.has(norm(candidate))) continue;
+    taken.add(norm(candidate));
+    out.push(candidate);
+  }
+  return out;
+}
+
+export const nextInvoiceNumber = (invoices, prefix = "INV") => nextInvoiceNumbers(invoices, 1, prefix)[0];
diff -ruN a/src/invoiceNumbering.test.mjs b/src/invoiceNumbering.test.mjs
--- a/src/invoiceNumbering.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/src/invoiceNumbering.test.mjs	2026-11-15 03:13:22.090049380 +0000
@@ -0,0 +1,42 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import { ownedInvoices, isInvoiceNumberTaken, nextInvoiceNumber, nextInvoiceNumbers } from "./invoiceNumbering.js";
+
+const inv = (projectId, invoiceNumber, ownerUserId = "u1") => ({ projectId, invoiceNumber, ownerUserId });
+
+test("a second project is never suggested a reference another project already uses", () => {
+  const all = [inv("A", "INV-0001"), inv("A", "INV-0002")];
+  assert.equal(nextInvoiceNumber(all, "INV"), "INV-0003");
+});
+
+test("numbers continue across document types and skip references already taken", () => {
+  const all = [inv("A", "PRO-0004"), inv("B", "INV-0002")];
+  assert.equal(nextInvoiceNumber(all, "REC"), "REC-0005");
+  assert.deepEqual(nextInvoiceNumbers(all, 3, "INV"), ["INV-0005", "INV-0006", "INV-0007"]);
+});
+
+test("a suggestion never equals an existing reference (case-insensitive), even with gaps and odd formats", () => {
+  const all = [inv("A", "inv-0003"), inv("B", "INV-0001"), inv("C", "INV-2026-001")];
+  for (const n of nextInvoiceNumbers(all, 10, "INV")) assert.equal(isInvoiceNumberTaken(all, n), false);
+  assert.equal(new Set(nextInvoiceNumbers(all, 10, "INV")).size, 10);
+});
+
+test("empty list starts at 0001", () => {
+  assert.equal(nextInvoiceNumber([], "INV"), "INV-0001");
+  assert.deepEqual(nextInvoiceNumbers(undefined, 2, "PRO"), ["PRO-0001", "PRO-0002"]);
+});
+
+test("only invoices owned by the current user count (uniqueness is per user_id)", () => {
+  const all = [inv("A", "INV-0001", "u1"), inv("B", "INV-0009", "u2"), { projectId: "C", invoiceNumber: "INV-0002" }];
+  assert.deepEqual(ownedInvoices(all, "u1").map((i) => i.invoiceNumber), ["INV-0001", "INV-0002"]);
+  assert.equal(nextInvoiceNumber(ownedInvoices(all, "u1"), "INV"), "INV-0003");
+});
+
+test("regression: App.jsx never numbers from a single project's invoices", () => {
+  const src = fs.readFileSync(new URL("./App.jsx", import.meta.url), "utf8");
+  assert.ok(!/nextInvoiceNumbers?\(\s*invoices\.filter/.test(src), "numbering must use ownInvoices, not a project filter");
+  assert.ok(!/nextInvoiceNumbers?\(\s*projectInvoices/.test(src));
+  assert.ok(/const ownInvoices = ownedInvoices\(invoices, userId\)/.test(src));
+  assert.ok(/e\?\.code === "23505"[^\n]*milestone/i.test(src), "milestone creation must explain a duplicate reference");
+});
diff -ruN a/src/invoicePdfLayout.js b/src/invoicePdfLayout.js
--- a/src/invoicePdfLayout.js	1970-01-01 00:00:00.000000000 +0000
+++ b/src/invoicePdfLayout.js	2026-11-15 03:12:21.102983392 +0000
@@ -0,0 +1,47 @@
+// Page-flow helpers for the invoice / proforma / receipt PDF (jsPDF, units: mm, A4 = 297 mm tall).
+// The PDF used to draw everything at fixed offsets and never started a new page, so long line-item lists and
+// long descriptions ran off the bottom of the page.
+
+export const PDF_PAGE_TOP = 22;
+export const PDF_PAGE_BOTTOM = 277;
+
+const lineHeightOf = (doc) => {
+  const factor = typeof doc.getLineHeightFactor === "function" ? doc.getLineHeightFactor() : 1.15;
+  const scale = doc.internal?.scaleFactor || 72 / 25.4;
+  return (doc.getFontSize() * factor) / scale;
+};
+
+// Draws wrapped `lines` starting at y, continuing on new pages when they would pass the bottom margin.
+// Returns the y just below the block, using `pitch` per line (the spacing the fixed layout always assumed), so a
+// block that fits on one page ends exactly where it did before.
+export function flowLines(doc, lines, x, y, { pitch = 6, top = PDF_PAGE_TOP, bottom = PDF_PAGE_BOTTOM } = {}) {
+  const all = Array.isArray(lines) ? lines : [String(lines ?? "")];
+  if (!all.length) return y;
+  const lineH = lineHeightOf(doc);
+  let i = 0;
+  let cy = y;
+  while (i < all.length) {
+    let fit = Math.floor((bottom - cy) / lineH);
+    if (fit < 1) { doc.addPage(); cy = top; fit = Math.max(1, Math.floor((bottom - cy) / lineH)); }
+    const chunk = all.slice(i, i + fit);
+    doc.text(chunk, x, cy);
+    i += chunk.length;
+    if (i < all.length) { doc.addPage(); cy = top; } else { cy += chunk.length * pitch; }
+  }
+  return cy;
+}
+
+// If `height` mm will not fit below y, starts a new page and returns the top margin; otherwise returns y.
+export function ensureSpace(doc, y, height, { top = PDF_PAGE_TOP, bottom = PDF_PAGE_BOTTOM } = {}) {
+  if (y + height <= bottom) return y;
+  doc.addPage();
+  return top;
+}
+
+// File name for the downloaded PDF: the document's own reference, so "INV-0007.pdf" rather than a generic
+// "invoice.pdf" that every download would share. Characters that are illegal in file names are replaced.
+export function invoicePdfFileName(invoice, { paystackRef = "", fallback = "invoice" } = {}) {
+  const raw = String(invoice?.invoiceNumber || "").trim() || String(paystackRef || "").trim() || fallback;
+  const safe = raw.replace(/[\\/:*?"<>|\u0000-\u001f]+/g, "-").replace(/\s+/g, " ").replace(/^[.\s-]+|[.\s-]+$/g, "").slice(0, 100);
+  return `${safe || fallback}.pdf`;
+}
diff -ruN a/src/invoicePdfLayout.test.mjs b/src/invoicePdfLayout.test.mjs
--- a/src/invoicePdfLayout.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/src/invoicePdfLayout.test.mjs	2026-11-15 03:13:28.286898485 +0000
@@ -0,0 +1,111 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import { flowLines, ensureSpace, invoicePdfFileName, PDF_PAGE_TOP, PDF_PAGE_BOTTOM } from "./invoicePdfLayout.js";
+import { invoiceT } from "./i18n/invoiceStrings.js";
+import { normalizeLang, formatDocDate } from "./i18n/languages.js";
+
+// Minimal jsPDF stand-in that records where text lands.
+class FakeDoc {
+  constructor() { this.page = 1; this.size = 10; this.draws = []; this.saved = null; this.internal = { scaleFactor: 72 / 25.4 }; }
+  getFontSize() { return this.size; }
+  getLineHeightFactor() { return 1.15; }
+  setFontSize(n) { this.size = n; }
+  setTextColor() {} setDrawColor() {} setFillColor() {} line() {} link() {} roundedRect() {} rect() {}
+  addPage() { this.page += 1; }
+  splitTextToSize(text, width) { const per = Math.max(10, Math.floor(width / 2)); const out = []; for (let i = 0; i < String(text).length; i += per) out.push(String(text).slice(i, i + per)); return out.length ? out : [""]; }
+  text(t, x, y) {
+    const lh = (this.size * 1.15) / (72 / 25.4);
+    (Array.isArray(t) ? t : [t]).forEach((line, i) => this.draws.push({ page: this.page, text: String(line), x, y: y + i * lh }));
+  }
+  save(name) { this.saved = name; }
+}
+
+test("flowLines keeps a block that fits on one page exactly where the fixed layout put it", () => {
+  const d = new FakeDoc();
+  assert.equal(flowLines(d, ["a", "b", "c"], 20, 100, { pitch: 6 }), 118);
+  assert.equal(d.page, 1);
+});
+
+test("flowLines breaks long blocks across pages and never draws below the bottom margin", () => {
+  const d = new FakeDoc();
+  const end = flowLines(d, Array.from({ length: 200 }, (_, i) => `line ${i}`), 20, 60, { pitch: 6 });
+  assert.ok(d.page > 1);
+  assert.equal(d.draws.length, 200);
+  assert.ok(d.draws.every((x) => x.y <= PDF_PAGE_BOTTOM + 0.001));
+  assert.ok(end >= PDF_PAGE_TOP);
+});
+
+test("ensureSpace only adds a page when the block would not fit", () => {
+  const d = new FakeDoc();
+  assert.equal(ensureSpace(d, 100, 20), 100);
+  assert.equal(d.page, 1);
+  assert.equal(ensureSpace(d, 270, 20), PDF_PAGE_TOP);
+  assert.equal(d.page, 2);
+});
+
+test("PDF file name is the document reference, sanitised, with sensible fallbacks", () => {
+  assert.equal(invoicePdfFileName({ invoiceNumber: "INV-0007" }), "INV-0007.pdf");
+  assert.equal(invoicePdfFileName({ invoiceNumber: " PRO/2026:001 " }), "PRO-2026-001.pdf");
+  assert.equal(invoicePdfFileName({ invoiceNumber: "" }, { paystackRef: "KRL-L-1" }), "KRL-L-1.pdf");
+  assert.equal(invoicePdfFileName({}, { fallback: "invoice" }), "invoice.pdf");
+  assert.equal(invoicePdfFileName({ invoiceNumber: "請求書 0001" }), "請求書 0001.pdf");
+});
+
+// Run the real downloadInvoicePDF from App.jsx against the fake doc.
+function loadDownload(doc, extra = {}) {
+  const src = fs.readFileSync(new URL("./App.jsx", import.meta.url), "utf8");
+  const i = src.indexOf("async function downloadInvoicePDF");
+  const j = src.indexOf("\nfunction cardFromRow");
+  const body = src.slice(i, j).replace('await import("jspdf")', "({ jsPDF: function () { return __fakeDoc; } })");
+  const parseMoney = (v) => Number(String(v ?? "").replace(/[^0-9.-]/g, "")) || 0;
+  const formatMoney = (v) => parseMoney(v).toFixed(2);
+  const deps = {
+    normalizeLang, invoiceT, formatDocDate, parseMoney, formatMoney, __fakeDoc: doc,
+    useJapaneseFont: async () => {}, wrapMixed: (d, t, w) => d.splitTextToSize(t, w),
+    DEFAULT_SETTINGS: {}, invoiceRefFor: () => "", createCheckoutSession: async () => ({}),
+    requestPayLink: async () => ({ ok: false }), drawPayNowButton: () => {},
+    flowLines, ensureSpace, invoicePdfFileName, PDF_PAGE_TOP, PDF_PAGE_BOTTOM,
+    window: { location: { origin: "https://example.test" } }, ...extra,
+  };
+  const names = Object.keys(deps);
+  return new Function(...names, `${body}\nreturn downloadInvoicePDF;`)(...names.map((n) => deps[n]));
+}
+
+const baseInvoice = { id: "i1", invoiceNumber: "INV-0007", docType: "invoice", language: "en", amountMode: "manual", amount: "500", amountPaid: "0", currency: "$", issueDate: "2026-11-15", dueDate: "2026-12-15", status: "unpaid", description: "Cleanup" };
+const project = { client: "Acme", name: "Spot" };
+const settings = { studioName: "Studio", invoicePaymentInstructions: "Pay by bank transfer.", invoiceFooterNote: "Thanks" };
+
+test("short invoice stays on one page, prints its reference number and is named after it", async () => {
+  const doc = new FakeDoc();
+  await loadDownload(doc)(baseInvoice, project, settings);
+  assert.equal(doc.page, 1);
+  assert.ok(doc.draws.some((d) => d.text === "Reference no.: INV-0007"));
+  assert.equal(doc.saved, "INV-0007.pdf");
+});
+
+test("60 line items flow onto extra pages; nothing is drawn off the page and the totals stay together", async () => {
+  const doc = new FakeDoc();
+  const lineItems = Array.from({ length: 60 }, (_, i) => ({ id: `l${i}`, description: `Shot ${i} cleanup and compositing`, qty: "1", unitPrice: "10" }));
+  await loadDownload(doc)({ ...baseInvoice, amountMode: "items", lineItems, amount: "600" }, project, settings);
+  assert.ok(doc.page >= 2);
+  assert.ok(doc.draws.every((d) => d.y <= PDF_PAGE_BOTTOM + 0.001), "text drawn below the bottom margin");
+  const balance = doc.draws.find((d) => d.text === "Balance due");
+  const subtotal = doc.draws.find((d) => d.text === "Subtotal");
+  assert.equal(balance.page, subtotal.page);
+  assert.ok(doc.draws.filter((d) => d.text === "Description").length >= 2, "column header repeats on continuation pages");
+});
+
+test("a very long single-amount description flows instead of overflowing", async () => {
+  const doc = new FakeDoc();
+  await loadDownload(doc)({ ...baseInvoice, description: "x".repeat(5000) }, project, settings);
+  assert.ok(doc.page >= 2);
+  assert.ok(doc.draws.every((d) => d.y <= PDF_PAGE_BOTTOM + 0.001));
+  assert.ok(doc.draws.some((d) => d.text === "Balance due"));
+});
+
+test("Japanese invoice prints the localised reference label", async () => {
+  const doc = new FakeDoc();
+  await loadDownload(doc)({ ...baseInvoice, language: "ja" }, project, settings);
+  assert.ok(doc.draws.some((d) => d.text === "書類番号: INV-0007"));
