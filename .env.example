# KairFlow Intelligence worker configuration template.
# Copy to a private worker.env file; never commit real credentials.

KAIRFLOW_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
KAIRFLOW_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
KAIRFLOW_AGENT_EMAIL=worker@example.com
# Leave blank when the password is stored in Windows Credential Manager (keyring).
KAIRFLOW_AGENT_PASSWORD=

# Ollama must remain on this computer; the controller rejects remote hosts.
KAIRFLOW_OLLAMA_URL=http://127.0.0.1:11434
KAIRFLOW_OLLAMA_MODEL=qwen2.5:3b-instruct
KAIRFLOW_OLLAMA_FAST_MODEL=qwen2.5:1.5b-instruct

# Optional: Gemini as the PRIMARY model for Agent Chat only (Ollama stays the fallback and handles research, classification
# and drafting). Leave the key blank to use Ollama only. Use a key from a billing-enabled Google project: as far as I know the
# free tier may use prompts to improve Google products. Chat text and tool results (prospect names, statuses, counts) are sent to Google.
KAIRFLOW_GEMINI_API_KEY=
KAIRFLOW_GEMINI_MODEL=gemini-2.5-flash

# Optional operational identity and contact details.
KAIRFLOW_WORKER_ID=
KAIRFLOW_CONTACT_URL=
KAIRFLOW_POLL_SECONDS=15

# Dynamic provider accounts are assigned by the server-side account registry.
# Keep the legacy adapter selector disabled unless an explicitly approved rollout requires it.
KAIRFLOW_MAIL_PROVIDER=none
KAIRFLOW_MAIL_ACCOUNT_ID=
